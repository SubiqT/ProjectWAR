<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>WorldServer</AssemblyName>
    <RootNamespace>WorldServer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <ApplicationIcon>world.ico</ApplicationIcon>
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appccelerate.StateMachine" Version="6.0.0" />
    <PackageReference Include="BehaviourTree" Version="1.0.73" />
    <PackageReference Include="BulletSharp" Version="0.11.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Files present on disk but never part of the build. Eight are stale copies
         of sources that live elsewhere in the tree, State2.cs and Mount.cs are
         unfinished work that does not compile. -->
    <Compile Remove="Console\ReloadScriptsCommand.cs" />
    <Compile Remove="NetWork\Handler\State2.cs" />
    <Compile Remove="World\AI\CombatCreatureStateMachine.cs" />
    <Compile Remove="World\AI\EnhancedCreature.cs" />
    <Compile Remove="World\AI\NonCombatCreatureStateMachine.cs" />
    <Compile Remove="World\AI\TargetSelectionMethod.cs" />
    <Compile Remove="World\AI\UnitAdaptor.cs" />
    <Compile Remove="World\Mounts\Mount.cs" />
    <Compile Remove="World\Scripting\AltdorfSewersWingIII.cs" />
    <Compile Remove="World\Scripting\ArdtaFeed.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountCacher\AccountCacher.csproj" />
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\FrameWork\FrameWork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Abilities\*.txt" CopyToOutputDirectory="Always" />
    <Content Include="Configs\LocalDevelopment\*.xml" />
    <Content Include="world.ico" />
    <None Include="NLog.config" CopyToOutputDirectory="Always" />
    <None Include="NLog.xsd" />
  </ItemGroup>

</Project>
