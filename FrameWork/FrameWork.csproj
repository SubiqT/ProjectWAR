<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FrameWork</AssemblyName>
    <RootNamespace>FrameWork</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <!-- The legacy protobuf-csharp-port assembly only targets .NET Framework. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3" />
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- protobuf-csharp-port 2.4.1, kept because the generated message code in
         NetWork/ProtocolBuffers targets its API and no .proto sources exist. -->
    <Reference Include="Google.ProtocolBuffers">
      <HintPath>..\deps\protobuf\Google.ProtocolBuffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
