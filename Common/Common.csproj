<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Common</AssemblyName>
    <RootNamespace>Common</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrameWork\FrameWork.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unfinished upstream character cache service, never part of the build. -->
    <Compile Remove="Rpc\CharacterMgr.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Google.ProtocolBuffers">
      <HintPath>..\deps\protobuf\Google.ProtocolBuffers.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icons\account.ico" />
    <Content Include="Icons\launcher.ico" />
    <Content Include="Icons\lobby.ico" />
    <Content Include="Icons\world.ico" />
  </ItemGroup>

</Project>
